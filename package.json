{
  "name": "cc-dsh",
  "version": "1.8.1",
  "private": true,
  "description": "Phone gateway for DeepSeek Harness: pair a phone, control sessions, models, presets, approvals, workspace files, a command terminal and DSH settings remotely.",
  "repository": { "type": "git", "url": "git+https://github.com/huajikano/dsh-PEC.git" },
  "homepage": "https://github.com/huajikano/dsh-PEC#readme",
  "bugs": { "url": "https://github.com/huajikano/dsh-PEC/issues" },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "web/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
